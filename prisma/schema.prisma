generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PractitionerStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceRecipientType {
  CLIENT
  PRACTITIONER
}

/// Payment collection only — invoice delivery is Order.invoiceSent.
enum PaymentStatus {
  PENDING
  PAID
}

/// Practitioner = logged-in Shopify customer who sells with markup.
model Practitioner {
  id                 String             @id @default(cuid())
  shopifyCustomerId  String             @unique
  shopifyCustomerGid String             @unique
  email              String
  firstName          String?
  lastName           String?
  displayName        String?
  status             PractitionerStatus @default(ACTIVE)
  lastSyncedAt       DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orders             Order[]

  @@index([email])
  @@index([status])
}

/// One checkout / draft → Shopify order for a practitioner.
model Order {
  id                    String                @id @default(cuid())
  practitionerId        String
  practitioner          Practitioner          @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  shopifyDraftOrderId   String                @unique
  shopifyDraftOrderName String?
  shopifyOrderId        String?               @unique
  shopifyOrderName      String?

  clientEmail           String?
  invoiceRecipientEmail String?
  invoiceRecipientType  InvoiceRecipientType?

  currency              String                @default("AUD")
  baseTotal             Decimal               @db.Decimal(12, 2)
  /// Sum of practitioner markups = earnings basis for dashboard.
  markupTotal           Decimal               @db.Decimal(12, 2)
  finalTotal            Decimal               @db.Decimal(12, 2)

  paymentStatus         PaymentStatus         @default(PENDING)
  invoiceSent           Boolean               @default(false)
  invoiceSentAt         DateTime?
  paidAt                DateTime?

  cartToken             String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  items                 OrderItem[]
  paymentEvents         PaymentEvent[]

  @@index([practitionerId, createdAt])
  @@index([practitionerId, paymentStatus])
  @@index([paymentStatus])
  @@index([clientEmail])
  @@index([createdAt])
}

/// Per-line financials so mixed carts / different markups report correctly.
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  shopifyVariantId String
  shopifyProductId String?
  productTitle     String?
  sku              String?
  quantity         Int
  priceSource      String?

  baseUnitPrice  Decimal  @db.Decimal(12, 2)
  markupPerUnit  Decimal  @db.Decimal(12, 2)
  markupTotal    Decimal  @db.Decimal(12, 2)
  finalUnitPrice Decimal  @db.Decimal(12, 2)
  finalLineTotal Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([shopifyVariantId])
}

/// Append-only payment status history for dashboard/audit.
model PaymentEvent {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  PaymentStatus?
  toStatus    PaymentStatus
  source      String
  note        String?
  createdAt   DateTime      @default(now())

  @@index([orderId, createdAt])
}
